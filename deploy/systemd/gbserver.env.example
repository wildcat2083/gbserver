# /etc/gbserver.env - secrets for gbserver.service (NOT committed to git)
#
# Install:
#   sudo install -m 600 -o root -g root deploy/systemd/gbserver.env.example /etc/gbserver.env
#   sudo nano /etc/gbserver.env
#
# Generate a token with:  openssl rand -hex 32
# Placeholders or anything under 32 characters disable the admin API.
GBSERVER_ADMIN_TOKEN=

# Optional overrides for the cert-expiry panel on the dashboard:
#GBSERVER_PUBLIC_CERT_PATH=/etc/letsencrypt/live/gbserver.wulfpax-labs.com/cert.pem
# Served through a Cloudflare Tunnel (no local public certificate)? Hide it:
#GBSERVER_PUBLIC_CERT_PATH=
#GBSERVER_INTERNAL_CERT_PATH=/etc/nginx/certs/gbserver.crt

# Hidden debugger: on (default) | internal (only via GBSERVER_INTERNAL_HOSTS) | off
#GBSERVER_DEBUGGER=on
#GBSERVER_INTERNAL_HOSTS=gbserver-internal.wulfpax-labs.com,localhost,127.0.0.1

# Optional: where the debugger looks for .sym symbol files
# (default: the symbols/ folder in the data directory)
#GBSERVER_SYMBOLS_DIR=/home/luna/gbserver-data
