# /etc/systemd/system/gbserver.service
#
# Runs the headless Game Boy server via gunicorn, listening on
# 127.0.0.1:8080 (nginx handles the public-facing side — see
# deploy/nginx/deploy_gbserver.conf).
#
# Install:
#   sudo cp deploy/systemd/gbserver.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gbserver
#
# Logs:
#   journalctl -u gbserver -f

[Unit]
Description=Headless Game Boy server (gunicorn)
After=network.target

[Service]
# Adjust User/WorkingDirectory/ExecStart to match where you deployed this
User=luna
WorkingDirectory=/home/luna/gbserver
ExecStart=/home/luna/gbserver/venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=on-failure
RestartSec=3

# PyBoy/SDL2 doesn't need a real display since we run window="null",
# but some environments still expect these to be set harmlessly.
Environment=SDL_VIDEODRIVER=dummy
Environment=SDL_AUDIODRIVER=dummy
Environment=GBSERVER_MAX_ROOMS=20

# Secrets live outside the repo. Create it from the example:
#   sudo install -m 600 -o root -g root deploy/systemd/gbserver.env.example /etc/gbserver.env
#   sudo nano /etc/gbserver.env        # paste in: openssl rand -hex 32
# The app refuses placeholder or short tokens and disables the admin API.
EnvironmentFile=/etc/gbserver.env

[Install]
WantedBy=multi-user.target
